MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/
MONGODB_DB=ocd_live
# Signs the admin session cookie — 32+ random characters
AUTH_SECRET=
# One-time code to create the first admin at /setup (16+ characters)
SETUP_TOKEN=
# Photos (logo + product images) — private Cloudinary storage
CLOUDINARY_URL=cloudinary://key:secret@cloud-name
CLOUDINARY_FOLDER=ocd-live
# Email (optional: without it, nothing is sent and bookings still work)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="OCD Live <no-reply@example.com>"
# Optional: where "new request" alerts go
ADMIN_NOTIFY_EMAIL=
